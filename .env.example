# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# Durable GitHub webhook delivery claims (Upstash Redis REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: short lease before a Workflow run durably confirms ownership.
ROD_DELIVERY_PENDING_TTL_SECONDS=120
# Optional: confirmed delivery retention. Default is 7 days.
ROD_DELIVERY_CLAIM_TTL_SECONDS=604800

# Vercel Sandbox authenticates automatically with OIDC on Vercel.
# For local development, set these if needed:
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
